        android:strokeLineJoin="round"
        android:pathData="M54,58 L80,67 L54,76 L28,67 Z" />
    <path
        android:strokeColor="#00E5FF"
        android:strokeAlpha="0.6"
        android:strokeWidth="0.8"
        android:pathData="M41,62.5 L67,71.5 M67,62.5 L41,71.5" />

